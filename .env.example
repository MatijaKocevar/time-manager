# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# For local development (SQLite)
DATABASE_URL="file:./database/dev.db"

# For Docker deployment (PostgreSQL)
# Uncomment and configure for Docker Compose:
# DATABASE_URL="postgresql://timeapp:timeapp_password@db:5432/timeapp"

# For production PostgreSQL (self-hosted)
# DATABASE_URL="postgresql://username:password@hostname:5432/database_name"

# ===========================================
# NEXTAUTH CONFIGURATION
# ===========================================

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Update for your domain (Docker: https://localhost or https://yourdomain.com)
NEXTAUTH_URL="http://localhost:3000"

# ===========================================
# APPLICATION BRANDING
# ===========================================

# Company name shown in the sidebar
NEXT_PUBLIC_COMPANY_NAME="Local Server"

# ===========================================
# ENCRYPTION (Required for Urnik integration)
# ===========================================

# Generate with: npm run generate:encryption-key
# Or Docker: docker compose run --rm app npm run generate:encryption-key
ENCRYPTION_KEY="your-64-character-hex-encryption-key-here"

# ===========================================
# OPTIONAL: URNIK.NET INTEGRATION
# ===========================================

# Company-wide tenant ID for Urnik.net (find in Urnik.net network requests as TenantID)
# URNIK_TENANT_ID="your-tenant-id-here"

# ===========================================
# CRON JOB AUTHENTICATION
# ===========================================

# Secret for authenticating cron job API calls
# Generate with: openssl rand -base64 32
# CRON_SECRET="your-secret-here"

# ===========================================
# OPTIONAL: EMAIL NOTIFICATIONS (Resend)
# ===========================================

# Sign up at https://resend.com
# RESEND_API_KEY="re_..."

# ===========================================
# OPTIONAL: PUSH NOTIFICATIONS (Web Push)
# ===========================================

# Generate VAPID keys with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."

# ===========================================
# OPTIONAL: REAL-TIME UPDATES (Pusher - Vercel only)
# ===========================================

# Sign up at https://pusher.com and create a Channels app
# Leave empty if using self-hosted server with SSE
# PUSHER_APP_ID="2101376"
# NEXT_PUBLIC_PUSHER_KEY="bdd46d9d5beb1aa00173"
# PUSHER_SECRET="bcb5c662f557a0198fd0"
# NEXT_PUBLIC_PUSHER_CLUSTER="eu"

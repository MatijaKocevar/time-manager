{
    "name": "time-management-app",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "./scripts/dev-https.sh",
        "dev:https": "next dev --hostname 0.0.0.0",
        "build": "next build",
        "migrate": "prisma migrate deploy",
        "start": "next start --hostname 0.0.0.0",
        "deploy": "./scripts/deploy.sh --no-migrate",
        "deploy:migrate": "./scripts/deploy.sh",
        "lint": "eslint",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:seed": "tsx prisma/seed/index.ts",
        "db:seed:minimal": "tsx prisma/seed/index.ts --minimal",
        "db:reset": "prisma migrate reset",
        "db:reset:minimal": "prisma migrate reset --skip-seed && npm run db:seed:minimal",
        "db:studio": "prisma studio",
        "db:clear": "tsx scripts/clear-time-data.ts",
        "db:seed:test-user": "tsx scripts/seed-test-user.ts",
        "dev:db": "npm run db:push && npm run db:seed && npm run dev",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "postinstall": "prisma generate",
        "cleanup:notifications": "tsx src/features/notifications/scripts/cleanup-notifications.ts",
        "generate-encryption-key": "tsx scripts/generate-encryption-key.ts",
        "build:cron": "esbuild scripts/sync-urnik-cron.ts --bundle --platform=node --outfile=scripts/build/sync-urnik-cron.js && esbuild scripts/auto-checkin-checkout-cron.ts --bundle --platform=node --external:@opentelemetry/api --external:@prisma/client --outfile=scripts/build/auto-checkin-checkout-cron.js"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.4.0",
        "@neondatabase/serverless": "^1.1.0",
        "@next-auth/prisma-adapter": "^1.0.7",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-icons": "^1.3.2",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-radio-group": "^1.3.8",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tailwindcss/typography": "^0.5.19",
        "@tanstack/react-query": "^5.100.14",
        "@tanstack/react-query-devtools": "^5.100.14",
        "@tanstack/react-table": "^8.21.3",
        "@tiptap/extension-image": "^3.23.4",
        "@tiptap/extension-link": "^3.23.4",
        "@tiptap/extension-placeholder": "^3.23.4",
        "@tiptap/react": "^3.23.4",
        "@tiptap/starter-kit": "^3.23.4",
        "@types/nprogress": "^0.2.3",
        "bcryptjs": "^3.0.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns-tz": "^3.2.0",
        "driver.js": "^1.4.0",
        "exceljs": "^4.4.0",
        "lucide-react": "^1.17.0",
        "next": "^16.2.6",
        "next-auth": "^4.24.14",
        "next-intl": "^4.13.0",
        "nprogress": "^0.2.0",
        "papaparse": "^5.5.3",
        "pg": "^8.21.0",
        "prisma": "^7.8.0",
        "pulltorefreshjs": "^0.1.22",
        "pusher": "^5.3.3",
        "pusher-js": "^8.5.0",
        "radix-ui": "^1.4.3",
        "react": "19.2.6",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.2.6",
        "react-hook-form": "^7.76.1",
        "resend": "^6.12.4",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "web-push": "^3.6.7",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.0",
        "@types/bcryptjs": "^3.0.0",
        "@types/node": "^25",
        "@types/papaparse": "^5.5.2",
        "@types/pulltorefreshjs": "^0.1.7",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/web-push": "^3.6.4",
        "babel-plugin-react-compiler": "1.0.0",
        "baseline-browser-mapping": "^2.10.32",
        "date-fns": "^4.4.0",
        "dotenv": "^17.4.2",
        "eslint": "^9",
        "eslint-config-next": "16.2.6",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "prettier": "^3.8.3",
        "tailwindcss": "^4",
        "tsx": "^4.22.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6"
    },
    "overrides": {
        "postcss": "^8.5.10",
        "@hono/node-server": "^1.19.13",
        "uuid": "^11.1.1"
    }
}

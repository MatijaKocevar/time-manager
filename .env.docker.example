# ========================================
# DOCKER ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env.docker before running docker compose
# This file contains all configuration for Docker deployment

# ========================================
# DATABASE CONFIGURATION (Local PostgreSQL)
# ========================================

DATABASE_URL="postgresql://timeapp:timeapp_password@db:5432/timeapp"
NODE_ENV="production"

# ========================================
# APPLICATION CONFIGURATION
# ========================================

# Authentication (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Company name shown in the sidebar
NEXT_PUBLIC_COMPANY_NAME="Local Server"

# Encryption Key (generate with: openssl rand -hex 32)
ENCRYPTION_KEY="your-encryption-key-here"

# ========================================
# OPTIONAL: URNIK.NET INTEGRATION
# ========================================

# Company-wide tenant ID for Urnik.net (find in Urnik.net network requests as TenantID)
# URNIK_TENANT_ID="your-tenant-id-here"

# ========================================
# OPTIONAL: EXTERNAL SERVICES
# ========================================
# Uncomment and configure if you want email/push notifications

# Email (Resend)
# RESEND_API_KEY=""

# Push Notifications (web-push)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""

# Real-time (Pusher - not needed for self-hosted)
# NEXT_PUBLIC_PUSHER_CLUSTER=""
# NEXT_PUBLIC_PUSHER_KEY=""
# PUSHER_APP_ID=""
# PUSHER_SECRET=""

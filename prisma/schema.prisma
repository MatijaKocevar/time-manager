generator client {
  provider        = "prisma-client-js"
  output          = "./generated/client"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String                  @unique
  emailVerified          DateTime?
  image                  String?
  password               String?
  role                   UserRole                @default(USER)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  isActive               Boolean                 @default(true)
  isDemo                 Boolean                 @default(false)
  deactivatedAt          DateTime?
  anonymizedAt           DateTime?
  sidebarOpen            Boolean                 @default(true)
  sidebarExpandedItems   Json?                   @default("[]")
  theme                  String                  @default("light")
  locale                 String                  @default("en")
  workStartTime          String?                 @default("08:00")
  workEndTime            String?                 @default("16:00")
  workHoursPerDay        Float?                  @default(8.0)
  trackerSelectedType    HourType                @default(WORK)
  trackerSelectedTaskId  String?
  urnikUsername          String?
  urnikPassword          String?
  urnikUserId            String?
  lastUrnikTestAt        DateTime?
  accounts                  Account[]
  hourEntries               HourEntry[]
  lists                     List[]
  notifications             Notification[]
  notificationPreference    NotificationPreference?
  preferences               UserPreferences?
  pushSubscriptions         PushSubscription[]
  approvedRequests          Request[]                   @relation("ApprovedRequests")
  cancelledRequests         Request[]                   @relation("CancelledRequests")
  rejectedRequests          Request[]                   @relation("RejectedRequests")
  requests                  Request[]
  sessions                  Session[]
  shifts                    Shift[]
  tasks                     Task[]
  taskTimeEntries           TaskTimeEntry[]
  urnikRequests             UrnikRequest[]
  autoCheckoutCancellations AutoCheckoutCancellation[]
  workTimeAdjustments       WorkTimeAdjustment[]
}

model HourEntry {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  hours       Float
  type        HourType @default(WORK)
  description String?
  taskId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  task        Task?    @relation(fields: [taskId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, type, taskId])
  @@index([userId])
  @@index([date])
  @@index([taskId])
}

// MATERIALIZED VIEW - Cannot DELETE/UPDATE directly
// Use refreshDailyHourSummary() from @/lib/materialized-views
// Automatically recalculated when HourEntry or TaskTimeEntry changes
view DailyHourSummary {
  userId        String
  date          DateTime
  type          HourType
  manualHours   Float
  trackedHours  Float
  totalHours    Float

  @@unique([userId, date, type])
  @@map("daily_hour_summary")
}

model Task {
  id           String          @id @default(cuid())
  userId       String
  title        String
  description  String?
  status       TaskStatus      @default(TODO)
  parentId     String?
  order        Int             @default(0)
  isExpanded   Boolean         @default(false)
  isSystemTask Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  listId       String?
  hourEntries HourEntry[]
  list        List?           @relation(fields: [listId], references: [id])
  parent      Task?           @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]          @relation("TaskHierarchy")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries TaskTimeEntry[]

  @@index([userId])
  @@index([listId])
  @@index([parentId])
  @@index([userId, status])
  @@index([userId, listId])
  @@index([userId, status, listId])
  @@index([userId, listId, status])
  @@index([id, title, status, listId])
}

model TaskTimeEntry {
  id        String    @id @default(cuid())
  taskId    String
  userId    String
  startTime DateTime
  endTime   DateTime?
  duration  Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  type      HourType  @default(WORK)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([startTime])
  @@index([userId, startTime])
  @@index([userId, endTime])
  @@index([taskId, startTime])
  @@index([userId, startTime, type])
}

model Request {
  id                  String        @id @default(cuid())
  userId              String
  type                RequestType
  status              RequestStatus @default(PENDING)
  startDate           DateTime
  endDate             DateTime
  reason              String?
  location            String?
  affectsHourType     Boolean       @default(false)
  approvedBy          String?
  approvedAt          DateTime?
  rejectedBy          String?
  rejectedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  cancellationReason  String?
  cancelledAt         DateTime?
  cancelledBy         String?
  skipHolidays        Boolean       @default(true)
  skipWeekends        Boolean       @default(true)
  endTime             String?
  isFullDay           Boolean       @default(true)
  originalEndDate     DateTime?
  originalStartDate   DateTime?
  requestedHours      Decimal?
  splitFrom           String?
  startTime           String?
  supersededBy        String?
  trimmedBy           String?
  urnikNetSynced      Boolean       @default(false)
  urnikNetStatus      UrnikRequestStatus?
  urnikNetSyncedAt    DateTime?
  urnikNetRequestNo   String?
  urnikNetError       String?
  approver            User?         @relation("ApprovedRequests", fields: [approvedBy], references: [id])
  canceller           User?         @relation("CancelledRequests", fields: [cancelledBy], references: [id])
  rejector            User?         @relation("RejectedRequests", fields: [rejectedBy], references: [id])
  splitFromRequest    Request?      @relation("SplitRequests", fields: [splitFrom], references: [id])
  splitRequests       Request[]     @relation("SplitRequests")
  supersededByRequest Request?      @relation("SupersededRequests", fields: [supersededBy], references: [id])
  supersededRequests  Request[]     @relation("SupersededRequests")
  trimmedByRequest    Request?      @relation("TrimmedRequests", fields: [trimmedBy], references: [id])
  trimmedRequests     Request[]     @relation("TrimmedRequests")
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([startDate])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model Shift {
  id            String        @id @default(cuid())
  userId        String
  date          DateTime
  location      ShiftLocation @default(OFFICE)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  endDateTime   DateTime?
  startDateTime DateTime?
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([userId, date])
  @@index([userId, startDateTime])
}

model List {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String?
  icon        String?
  order       Int      @default(0)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, order])
}

model Holiday {
  id          String   @id @default(cuid())
  date        DateTime @unique
  name        String
  description String?
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model NotificationPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  emailNewRequest       Boolean  @default(true)
  emailRequestApproved  Boolean  @default(true)
  emailRequestRejected  Boolean  @default(true)
  emailRequestCancelled Boolean  @default(true)
  pushNewRequest        Boolean  @default(true)
  pushRequestApproved   Boolean  @default(true)
  pushRequestRejected   Boolean  @default(true)
  pushRequestCancelled  Boolean  @default(true)
  emailAutoCheckin      Boolean  @default(true)
  pushAutoCheckin       Boolean  @default(true)
  emailAutoCheckout     Boolean  @default(true)
  pushAutoCheckout      Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  url       String?
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model UserPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  hoursViewMode        String   @default("weekly")
  hoursCardCollapsed   Boolean  @default(false)
  hoursExpandedRows    Json?    @default("[]")
  autoCheckInEnabled   Boolean  @default(false)
  autoCheckOutEnabled  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserRole {
  USER
  ADMIN
}

enum HourType {
  WORK
  VACATION
  SICK_LEAVE
  WORK_FROM_HOME
  BREAK
  PRIVATE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  ON_HOLD
  CANCELED
}

enum RequestType {
  WORK
  VACATION
  SICK_LEAVE
  WORK_FROM_HOME
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ShiftLocation {
  OFFICE
  HOME
  VACATION
  SICK_LEAVE
}

enum NotificationType {
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_CANCELLED
  AUTO_CHECKIN_REMINDER
  AUTO_CHECKIN_COMPLETED
  AUTO_CHECKOUT_REMINDER
  AUTO_CHECKOUT_COMPLETED
}

enum UrnikRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
  FAILED
}

enum UrnikRequestCategory {
  HOUR
  DAY
}

model AutoCheckoutCancellation {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model WorkTimeAdjustment {
  id                 String   @id @default(cuid())
  userId             String
  date               DateTime
  adjustedStartTime  String?
  adjustedEndTime    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model UrnikRequest {
  id              String                @id @default(cuid())
  userId          String
  category        UrnikRequestCategory  @default(HOUR)
  date            DateTime
  endDate         DateTime?
  startTime       String?
  endTime         String?
  hours           Float?
  type            HourType
  urnikType       Int?
  status          UrnikRequestStatus    @default(PENDING)
  submittedAt     DateTime              @default(now())
  confirmedAt     DateTime?
  errorMessage    String?
  urnikRequestNo  String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([date])
  @@index([category])
}
